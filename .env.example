# ==========================================
# LingoBridge Environment Configuration Template
# ==========================================

# --- Frontend (Vite) Variables ---
# Google OAuth 2.0 Web Client ID for Google Identity Services
VITE_GOOGLE_CLIENT_ID=
# Optional: External Backend API URL (leave blank for same-origin Vercel hosting)
VITE_API_URL=

# --- Backend Variables ---
PORT=5000
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TRANSLATE_API_KEY=
TRANSLATION_API_KEY=

# --- Optional Production Database Variables ---
# Vercel KV / Upstash Redis (1-Click on Vercel Dashboard)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# MongoDB Atlas
MONGODB_URI=
MONGODB_DB_NAME=lingobridge

# PostgreSQL / Supabase / Neon
DATABASE_URL=
POSTGRES_URL=
